flowchart TB
    %% Linking the subgraphs, not their nodes, keeps each subgraph's own direction;
    %% visible subgraph boxes make that link read as "this stage leads to the next".
    subgraph r1 ["Especificación"]
        direction LR
        const["<code>constitution</code><br/><span class="cap">Principios del proyecto</span>"]
        spec["<code>specify</code><br/><span class="cap">spec.md<br/>FR-###, SC-###</span>"]
        clar["<code>clarify</code><br/><span class="cap">Ambigüedades resueltas</span>"]
        dudas{"¿quedan dudas?"}
        const --> spec --> clar --> dudas
        dudas -- sí --> clar
    end
    subgraph r2 ["Planificación"]
        direction LR
        plan["<code>plan</code><br/><span class="cap">plan.md<br/>research.md</span>"]
        tasks["<code>tasks</code><br/><span class="cap">tasks.md<br/>T### → FR</span>"]
        anal["<code>analyze</code><br/><span class="cap">Consistencia entre<br/>spec, plan y tareas</span>"]
        hallazgos{"¿hallazgos?"}
        plan --> tasks --> anal --> hallazgos
        hallazgos -- "sí: corregir artefactos" --> anal
    end
    subgraph r3 ["Implementación"]
        direction LR
        impl["<code>implement</code><br/><span class="cap">Código</span>"]
        conv["<code>converge</code><br/><span class="cap">Código vs. spec</span>"]
        falta{"¿falta algo?"}
        fin(["convergió"])
        impl --> conv --> falta
        falta -- no --> fin
        falta -- "sí: tareas nuevas" --> impl
    end
    r1 -- no --> r2
    r2 -- no --> r3
