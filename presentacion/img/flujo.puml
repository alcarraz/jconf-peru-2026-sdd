@startuml
skinparam defaultFontName "Noto Sans"
skinparam backgroundColor transparent
skinparam ArrowColor #111111
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #E20613
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #E20613
skinparam ActivityFontSize 13
skinparam PartitionBorderColor #CFCFCF
skinparam PartitionBackgroundColor #F4F4F4

start
partition "Especificación" {
  :**""constitution""**\n<size:11>Principios del proyecto</size>;
  :**""specify""**\n<size:11>spec.md: FR-###, SC-###</size>;
  repeat :**""clarify""**\n<size:11>Ambigüedades resueltas</size>;
  repeat while (¿quedan dudas?) is (sí) not (no)
}
partition "Planificación" {
  :**""plan""**\n<size:11>plan.md, research.md</size>;
  :**""tasks""**\n<size:11>tasks.md: T### → FR</size>;
  repeat :**""analyze""**\n<size:11>Consistencia entre spec, plan y tareas</size>;
  backward :corregir artefactos;
  repeat while (¿hallazgos?) is (sí) not (no)
}
partition "Implementación" {
  repeat :**""implement""**\n<size:11>Código</size>;
    :**""converge""**\n<size:11>Código vs. spec</size>;
  backward :tareas nuevas en tasks.md;
  repeat while (¿falta algo?) is (sí) not (no)
}
:convergió: PR;
stop
@enduml
